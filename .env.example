# MONGODB_URI: Connection string for MongoDB.
# Users configure this via the Secrets panel in the AI Studio UI.
MONGODB_URI="mongodb+srv://..."

# PORT: Local backend/frontend port. Change this if 3000 is already in use.
PORT="3000"
NODE_ENV="production"
APP_URL="https://your-domain.com"
JWT_SECRET="generate-a-long-random-secret"
SEED_DEMO_DATA="false"

# DISABLE_HMR: Set to "true" if Vite reports that WebSocket port 24678 is already in use.
DISABLE_HMR="false"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_MODEL_DIR: Directory created by ml/train_plant_model.py.
AI_MODEL_DIR="ml/artifacts/plant-health-model"

# PYTHON_BIN: Python executable used by the backend for model inference.
PYTHON_BIN="python"

# AI_CONFIDENCE_THRESHOLD: Minimum fused image + IoT score required for organic approval.
AI_CONFIDENCE_THRESHOLD="0.65"

# OTP settings
# OTP_DELIVERY_PROVIDER: Email OTP provider for login/reset-password.
# Options: "console" logs OTPs locally; "email" sends real OTP emails.
OTP_DELIVERY_PROVIDER="console"

# PHONE_OTP_PROVIDER: Registration phone OTP provider.
# Options: "console" logs OTPs locally; "msg91" sends real SMS OTP via MSG91.
PHONE_OTP_PROVIDER="console"
OTP_EXPIRY_MINUTES="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_ATTEMPTS="5"

# SMTP settings for real OTP delivery when OTP_DELIVERY_PROVIDER="email"
# Example for Gmail:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your_gmail_app_password"
# EMAIL_FROM="AgriTrustra <your-email@gmail.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# MSG91 settings for real phone OTP during registration
# Create an OTP template in MSG91 and paste its Template ID here.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# ============================================
# VERIFICATION SETTINGS (Aadhaar, Phone, KYC)
# ============================================

# AADHAAR_PROVIDER: Verification service for Aadhaar
# Options: "mock" (development), "signzy" (production), "digilocker" (DigiLocker eKYC)
AADHAAR_PROVIDER="mock"

# Signzy API credentials for real Aadhaar verification
# Get credentials at: https://www.signzy.com/
SIGNZY_API_KEY=""
SIGNZY_API_SECRET=""
SIGNZY_AADHAAR_VERIFY_URL="https://api.signzy.com/api/v1/aadhaar/verify"
AADHAAR_REQUEST_TIMEOUT_MS="15000"

# PHONE_VERIFICATION_PROVIDER: Local phone carrier verification mode.
PHONE_VERIFICATION_PROVIDER="mock"

# ENABLE_STRICT_VERIFICATION: Require real Aadhaar verification before registration
# Set to "false" to allow registration without real verification (development only)
ENABLE_STRICT_VERIFICATION="false"

# BLOCKCHAIN_RPC_URL: EVM RPC endpoint, for example Ganache/Hardhat local RPC or a testnet RPC.
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"

# BLOCKCHAIN_PRIVATE_KEY: Private key for the wallet that owns/deploys AgriTrustraCertificate.
BLOCKCHAIN_PRIVATE_KEY="YOUR_PRIVATE_KEY"

# CERTIFICATE_CONTRACT_ADDRESS: Address of the deployed AgriTrustraCertificate contract.
CERTIFICATE_CONTRACT_ADDRESS="0x..."

# BLOCKCHAIN_EXPLORER_TX_URL: Optional explorer transaction URL prefix or template.
# Examples:
# BLOCKCHAIN_EXPLORER_TX_URL="https://sepolia.etherscan.io/tx"
# BLOCKCHAIN_EXPLORER_TX_URL="https://sepolia.etherscan.io/tx/{txHash}"
BLOCKCHAIN_EXPLORER_TX_URL=""
