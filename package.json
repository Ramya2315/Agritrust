{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "mongo:local": "powershell -ExecutionPolicy Bypass -File scripts/start-mongodb-local.ps1",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev-with-mongodb.ps1",
    "dev:server": "powershell -ExecutionPolicy Bypass -File scripts/dev-with-mongodb.ps1",
    "dev:debug": "powershell -ExecutionPolicy Bypass -Command \"$env:PORT='3001'; npx tsx server.ts\"",
    "dev:3010": "powershell -Command \"$env:PORT='3010'; npx tsx server.ts\"",
    "build": "vite build --configLoader runner",
    "build:server": "esbuild server.ts --platform=node --packages=external --format=esm --bundle --outfile=dist/server.js",
    "build:prod": "npm run build && npm run build:server",
    "preview": "vite preview --configLoader runner",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "devtools": "react-devtools",
    "lint": "tsc --noEmit",
    "start": "node dist/server.js",
    "start:dev": "npx tsx server.ts",
    "start:prod": "powershell -Command \"$env:NODE_ENV='production'; $env:PORT='3010'; node dist/server.js\"",
    "ml:install": "python -m pip install -r ml/requirements.txt",
    "ml:train": "python ml/train_plant_model.py --plantvillage datasets/PlantVillage",
    "ml:train:all": "python ml/train_plant_model.py --plantvillage datasets/PlantVillage --plantdoc datasets/PlantDoc",
    "ml:train:organic": "python ml/train_organic_classifier.py --plantvillage datasets/PlantVillage",
    "ml:train:tomato-price": "python ml/train_tomato_price_sklearn.py --csv datasets/tomato-prices.csv --out ml/artifacts/tomato-price-model",
    "ml:test": "python ml/evaluate_model.py --plantvillage datasets/PlantVillage",
    "ml:test:all": "python ml/evaluate_model.py --plantvillage datasets/PlantVillage --plantdoc datasets/PlantDoc",
    "ml:test:organic": "python ml/predict_organic.py --plant-image datasets/PlantVillage/train/Apple___healthy/image1.jpg",
    "ml:test:tomato-price": "python ml/predict_tomato_price.py --model ml/artifacts/tomato-price-model --csv datasets/tomato-prices.csv",
    "ml:baseline": "python ml/train_baseline_numpy.py --plantvillage datasets/PlantVillage",
    "ml:iot": "python ml/simulate_iot.py --out ml/artifacts/iot-simulation.csv",
    "ganache": "ganache --host 127.0.0.1 --port 8545"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.4.1",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.7",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "utif": "^3.1.0",
    "vite": "^6.2.0"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.2.3",
    "@types/utif": "^3.0.6",
    "autoprefixer": "^10.4.21",
    "ganache": "^6.4.5",
    "react-devtools": "^7.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "esbuild": "^0.25.12"
  }
}
